{
  "info": {
    "_postman_id": "gfmms-backend-api-collection",
    "name": "GFMMS - Gym & Fitness Center Membership Management System API",
    "description": "Postman Collection for GFMMS backend core modules (Module A: Member Registration & Membership, Module B: Attendance Check-in & Class Booking)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Module A - Member Registration & Membership",
      "item": [
        {
          "name": "POST /members/register - Register Member (Success)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Sharma\",\n  \"dateOfBirth\": \"1996-08-15\",\n  \"contactNumber\": \"+919876543299\",\n  \"emailAddress\": \"rahul.sharma@example.com\",\n  \"emergencyContact\": \"+919876543290\",\n  \"planID\": \"<PLAN_ID>\",\n  \"paymentMethod\": \"CreditCard\"\n}"
            },
            "url": { "raw": "http://localhost:3000/members/register", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["members", "register"] }
          }
        },
        {
          "name": "POST /members/register - Register Member (Payment Failed)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Simulated Fail\",\n  \"dateOfBirth\": \"1998-01-01\",\n  \"contactNumber\": \"+919876543298\",\n  \"emailAddress\": \"fail.test@example.com\",\n  \"emergencyContact\": \"+919876543297\",\n  \"planID\": \"<PLAN_ID>\",\n  \"paymentMethod\": \"FAIL\"\n}"
            },
            "url": { "raw": "http://localhost:3000/members/register", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["members", "register"] }
          }
        },
        {
