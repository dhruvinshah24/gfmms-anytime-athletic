            },
            "url": { "raw": "http://localhost:3000/members/:id/login", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["members", ":id", "login"] }
          }
        },
        {
          "name": "GET /plans - Available Membership Plans",
