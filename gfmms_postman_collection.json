        {
          "name": "POST /bookings/:bookingId/cancel - Cancel Booking",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:3000/bookings/:bookingId/cancel", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["bookings", ":bookingId", "cancel"] }
          }
        },
        {
          "name": "GET /classes/:classId/waitlist - View Waitlist",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3000/classes/:classId/waitlist", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["classes", ":classId", "waitlist"] }
