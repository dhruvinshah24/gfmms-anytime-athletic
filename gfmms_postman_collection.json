      ]
    },
    {
      "name": "Module B - Attendance & Class Booking",
      "item": [
        {
          "name": "POST /attendance/checkin - Record Check-In (QR/Manual)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"membershipID\": \"<MEMBERSHIP_ID>\",\n  \"method\": \"QR\"\n}"
            },
            "url": { "raw": "http://localhost:3000/attendance/checkin", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["attendance", "checkin"] }
          }
        },
        {
          "name": "POST /classes - Create Fitness Class",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Evening Pilates\",\n  \"category\": \"Core\",\n  \"trainerID\": \"TR-202\",\n  \"schedule\": \"2026-10-25T18:00:00.000Z\",\n  \"durationMinutes\": 60,\n  \"capacity\": 15,\n  \"isRecurring\": true\n}"
            },
            "url": { "raw": "http://localhost:3000/classes", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["classes"] }
          }
        },
        {
          "name": "POST /classes/:classId/book - Book Class",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"membershipID\": \"<MEMBERSHIP_ID>\"\n}"
            },
            "url": { "raw": "http://localhost:3000/classes/:classId/book", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["classes", ":classId", "book"] }
          }
