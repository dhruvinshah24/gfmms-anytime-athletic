            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durationDays\": 30\n}"
            },
            "url": { "raw": "http://localhost:3000/memberships/:id/extend", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["memberships", ":id", "extend"] }
          }
        },
        {
          "name": "GET /memberships/check-grace/:membershipID - Check Grace Period",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3000/memberships/check-grace/:membershipID", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["memberships", "check-grace", ":membershipID"] }
          }
        },
        {
