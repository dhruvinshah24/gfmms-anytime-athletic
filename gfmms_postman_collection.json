        },
        {
          "name": "GET /payments/:id/invoice - Generate Invoice",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3000/payments/:id/invoice", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["payments", ":id", "invoice"] }
          }
